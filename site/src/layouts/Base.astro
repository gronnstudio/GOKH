---
// Latin and Latin Extended cover Dutch, English and the author names in our sources.
import "@fontsource/syne/latin-600.css"
import "@fontsource/syne/latin-ext-600.css"
import "@fontsource-variable/montserrat/wght.css"
import "@fontsource/geist-mono/latin-500.css"
import "@fontsource/geist-mono/latin-ext-500.css"
import "../styles/global.css"
import { t, type Lang } from "../lib/i18n.ts"

interface Props {
  lang: Lang
  title: string
  description: string
  /** The path after /<lang>/, so the language switch lands on the same page. */
  path: string
  current?: "entries" | "sources" | "contribute"
}
const { lang, title, description, path, current } = Astro.props
const ui = t(lang)
const other: Lang = lang === "nl" ? "en" : "nl"
const REPO = "https://github.com/gronnstudio/GOKH"
const navItems = [
  ["entries", ""],
  ["sources", "sources/"],
  ["contribute", "contribute/"],
] as const
// Prerender a same-site page when the pointer rests on its link. Browsers without the API ignore this.
const speculation = JSON.stringify({
  prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/pagefind/*" } }] }, eagerness: "moderate" }],
})
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex">
<link rel="alternate" hreflang={lang} href={`/${lang}/${path}`}>
<link rel="alternate" hreflang={other} href={`/${other}/${path}`}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script is:inline data-themes={JSON.stringify(ui.themes)}>
  // Theme: system, light or dark. Set before first paint so there is no flash; the button cycles it.
  (() => {
    const root = document.documentElement, names = JSON.parse(document.currentScript.dataset.themes), order = ["system", "light", "dark"]
    const read = () => { try { return localStorage.getItem("theme") || "system" } catch { return "system" } }
    const apply = (mode) => {
      if (mode === "system") root.removeAttribute("data-theme"); else root.dataset.theme = mode
      for (const b of document.querySelectorAll("[data-theme-toggle]")) {
        b.querySelector("[data-theme-name]").textContent = names[mode]
        b.setAttribute("aria-label", `${b.dataset.label}: ${names[mode]}`)
      }
    }
    apply(read())
    document.addEventListener("DOMContentLoaded", () => apply(read()))
    document.addEventListener("click", (e) => {
      if (!e.target.closest("[data-theme-toggle]")) return
      const next = order[(order.indexOf(read()) + 1) % order.length]
      try { localStorage.setItem("theme", next) } catch {}
      apply(next)
    })
  })()
</script>
<script type="speculationrules" is:inline set:html={speculation} />
<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
<script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">{ui.skip}</a>
<header class="bar">
  <a class="brand" href={`/${lang}/`}>Equilibrium</a>
  <nav aria-label={ui.main}>
    {navItems.map(([key, p]) => (
      <a href={`/${lang}/${p}`} aria-current={current === key ? "page" : undefined}>{ui.nav[key]}</a>
    ))}
  </nav>
  <div class="tools">
    <pagefind-modal-trigger class="search-trigger" placeholder={ui.searchShort}></pagefind-modal-trigger>
    <button type="button" class="tool theme" data-theme-toggle data-label={ui.theme} aria-label={`${ui.theme}: ${ui.themes.system}`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" /></svg>
      <span data-theme-name>{ui.themes.system}</span>
    </button>
    <a class="tool" href={`/${other}/${path}`} hreflang={other} lang={other}>{ui.other}</a>
  </div>
</header>
<pagefind-modal></pagefind-modal>
<p class="preview">{ui.preview}</p>
<main id="main">
<slot />
</main>
<footer class="foot">
  <p>{ui.licence} <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · {ui.code} · {ui.steward} <a href="https://gronn.studio">GRØNN Studio</a> · <a href={REPO}>{ui.sourceOnGithub}</a></p>
</footer>
</body>
</html>
