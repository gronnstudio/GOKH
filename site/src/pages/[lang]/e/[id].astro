---
import { marked } from "marked"
import Base from "../../../layouts/Base.astro"
import Grade from "../../../components/Grade.astro"
import SourceLine from "../../../components/SourceLine.astro"
import { byId, entries, inbound, pick, sourceByKey, startedFrom, type LoadedEntry, type Source } from "../../../lib/content.ts"
import { DOMAINS, LANGS, VERB_IN, VERB_OUT, entryHref, t, type Lang } from "../../../lib/i18n.ts"

export function getStaticPaths() {
  return LANGS.flatMap((lang) => entries.map((e) => ({ params: { lang, id: e.data.id } })))
}
const lang = Astro.params.lang as Lang
const e = byId.get(Astro.params.id!)!
const ui = t(lang)
const REPO = "https://github.com/gronnstudio/GOKH"
const title = pick(e.data.title, lang)
const summary = pick(e.data.summary, lang)
const body = pick(e.body, lang)
const name = (x: LoadedEntry) => pick(x.data.title, lang)
const srcs = e.data.sources.map((k) => sourceByKey.get(k)).filter((s): s is Source => Boolean(s))
const fallbackNote = (x: { fallback: boolean; lang: Lang }) => (x.fallback ? x.lang : undefined)
---
<Base lang={lang} title={`${title.text} · Equilibrium`} description={summary.text} path={`e/${e.data.id}/`}>
  <article class="entry" data-pagefind-body>
    <p class="label" data-pagefind-ignore><a href={`/${lang}/`}>{ui.nav.entries}</a> / {DOMAINS[e.data.domain][lang][0]}</p>
    <h1 lang={fallbackNote(title)} style={`view-transition-name: entry-${e.data.id}`}>{title.text}</h1>
    <p class="lead" lang={fallbackNote(summary)}>{summary.text}</p>
    <p class="label" data-pagefind-ignore>
      <span class="chip chip-contested">{ui.status[e.data.status]}</span>
      {e.data.level && <> · {ui.level[e.data.level]}</>} · {ui.updated} {e.data.updated} · <a href={`${REPO}/blob/main/content/entries/${e.file}`}>{ui.edit}</a>
    </p>
    {body.text && (
      <>
        {body.fallback && <p class="note" data-pagefind-ignore>{ui.notTranslated}</p>}
        <div class="prose" lang={fallbackNote(body)} set:html={marked.parse(body.text) as string} />
      </>
    )}

    {e.data.start.length > 0 && (
      <section>
        <h2>{ui.readFirst}</h2>
        <ol class="reads">
          {e.data.start.map((k) => byId.get(k)!).map((x) => {
            const n = name(x), s = pick(x.data.summary, lang)
            return <li><a href={entryHref(lang, x.data.id)} lang={fallbackNote(n)}>{n.text}</a> <span class="muted" lang={fallbackNote(s)}>{s.text}</span></li>
          })}
        </ol>
      </section>
    )}

    {e.data.relations.length > 0 && (
      <section data-pagefind-ignore>
        <h2>{ui.connectionsTitle}</h2>
        <ul class="rels">
          {e.data.relations.map((r) => {
            const to = byId.get(r.to)!, n = name(to), why = pick(r.why, lang)
            return (
              <li class="rel">
                <p><span class="verb">{VERB_OUT[r.verb][lang]}</span> <a href={entryHref(lang, to.data.id)} lang={fallbackNote(n)}>{n.text}</a></p>
                <p lang={fallbackNote(why)}>{why.text}</p>
                <div class="label"><Grade grade={r.grade} lang={lang} id={`out-${r.to}`} />{r.review && <> <span class="chip chip-contested" title={ui.verbNotReviewedNote}>{ui.verbNotReviewed}</span></>}</div>
              </li>
            )
          })}
        </ul>
      </section>
    )}

    {(inbound.get(e.data.id) ?? []).length > 0 && (
      <section data-pagefind-ignore>
        <h2>{ui.connectedFrom}</h2>
        <ul class="rels">
          {inbound.get(e.data.id)!.map(({ from, r }) => {
            const n = name(from), why = pick(r.why, lang)
            return (
              <li class="rel">
                <p><span class="verb">{VERB_IN[r.verb][lang]}</span> <a href={entryHref(lang, from.data.id)} lang={fallbackNote(n)}>{n.text}</a></p>
                <p lang={fallbackNote(why)}>{why.text}</p>
                <div class="label"><Grade grade={r.grade} lang={lang} id={`in-${from.data.id}`} /></div>
              </li>
            )
          })}
        </ul>
      </section>
    )}

    {(startedFrom.get(e.data.id) ?? []).length > 0 && (
      <section data-pagefind-ignore>
        <h2>{ui.startingPointFor}</h2>
        <ul>{startedFrom.get(e.data.id)!.map((p) => { const n = name(p); return <li><a href={entryHref(lang, p.data.id)} lang={fallbackNote(n)}>{n.text}</a></li> })}</ul>
      </section>
    )}

    {srcs.length > 0 && (
      <section data-pagefind-ignore>
        <h2>{ui.sourcesTitle}</h2>
        <ol class="srcs">{srcs.map((s) => <li><SourceLine s={s} lang={lang} /></li>)}</ol>
      </section>
    )}
  </article>
</Base>
