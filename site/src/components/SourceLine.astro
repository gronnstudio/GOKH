---
import type { Source } from "../lib/content.ts"
import { t, type Lang } from "../lib/i18n.ts"
interface Props { s: Source; lang: Lang }
const { s, lang } = Astro.props
const ui = t(lang)
---
{s.authors} ({s.year}). <cite lang="en">{s.title}</cite>{s.container && <>. {s.container}</>}.{" "}
{s.doi ? <a href={`https://doi.org/${s.doi}`}>doi:{s.doi}</a> : s.isbn ? <>ISBN {s.isbn}</> : s.url ? <a href={s.url}>{s.url}</a> : null}{" "}
{s.verified
  ? <span class="chip chip-ok" title={ui.verifiedNote}>{ui.verified}</span>
  : <span class="chip chip-warn" title={ui.unverifiedNote}>{ui.unverified}</span>}
