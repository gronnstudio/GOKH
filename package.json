{
  "name": "equilibrium",
  "version": "0.0.1",
  "description": "Equilibrium: the open, evidence-graded knowledge hub for designing with living systems in the Low Countries",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit && astro check",
    "tokens": "tsx scripts/tokens.ts",
    "lint:css": "stylelint \"site/src/**/*.css\"",
    "check": "npm run typecheck && npm run validate && npm run tokens -- --check && npm run lint:css",
    "export": "tsx scripts/export.ts",
    "resolve": "tsx scripts/resolve-sources.ts",
    "dev": "astro dev",
    "build:site": "astro build && pagefind --site dist/site",
    "build": "npm run validate && npm run build:site",
    "budget": "tsx scripts/budget.ts",
    "preview": "astro preview",
    "test:site": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "browserslist": "4.29.3",
    "lightningcss": "1.33.0",
    "pagefind": "1.5.2",
    "stylelint": "17.16.0",
    "stylelint-plugin-use-baseline": "1.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "astro": "7.3.5",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.4",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "private": true,
  "type": "module"
}
