{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/site",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/en/:path*",
      "destination": "/nl/:path*",
      "permanent": false
    },
    {
      "source": "/e/:id/",
      "destination": "/nl/e/:id/",
      "permanent": false
    },
    {
      "source": "/sources/",
      "destination": "/nl/sources/",
      "permanent": false
    },
    {
      "source": "/contribute/",
      "destination": "/nl/contribute/",
      "permanent": false
    }
  ]
}
