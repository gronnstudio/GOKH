  "theme": {
    "$type": "color",
    "$description": "What the site uses. $value is Golden Hour (light); $extensions.studio.gronn.dark is Blauwe Uur (dark).",
    "paper": {
      "$value": "{color.gebroken-wit}",
      "$description": "Page background.",
      "$extensions": {
        "studio.gronn.dark": "{color.antraciet}"
      }
    },
    "surface": {
      "$value": "{color.papier-licht}",
      "$description": "Cards, inputs, popovers.",
